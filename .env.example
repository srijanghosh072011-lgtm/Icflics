# Copy to .dev.vars for local development, and set the same keys as
# encrypted Secrets in the Cloudflare Pages dashboard for production.
#
#   Settings -> Environment variables -> Add variable -> Encrypt

# Required. Email address the owner signs in with.
OWNER_EMAIL="owner@example.com"

# Required. PBKDF2 hash of the owner password.
# Generate with:  npm run owner:hash -- "a-long-random-passphrase"
OWNER_PASSWORD_HASH="pbkdf2$210000$...$..."

# Optional. Cloudflare Turnstile keys. When TURNSTILE_SECRET is set the
# booking form requires a Turnstile token server-side.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# Optional. Salt used when hashing submitter IPs for abuse tracking.
# Any long random string. Changing it resets stored IP hashes.
IP_HASH_SALT="change-me-to-a-long-random-string"

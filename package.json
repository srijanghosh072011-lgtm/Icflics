{
  "name": "icflic-site",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site and booking system for Icflic sports photography.",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:init": "wrangler d1 execute icflic-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute icflic-db --remote --file=./schema.sql",
    "owner:hash": "node scripts/hash-password.mjs",
    "set-domain": "node scripts/set-domain.mjs",
    "check": "node scripts/preflight.mjs",
    "deploy": "wrangler pages deploy public",
    "sitemap": "node scripts/build-sitemap.mjs",
    "preview:root": "node scripts/build-ghpages.mjs --base /Icflics && node scripts/copy-to-root.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.131.0"
  },
  "engines": {
    "node": ">=20"
  }
}
